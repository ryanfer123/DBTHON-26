# Local-only settings. Copy to .env; fill the empty value locally.
POSTGRES_DB=dbthon
POSTGRES_USER=dbthon
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
# Separate restricted pools. `make db-access` fills these locally after migration.
APP_DATABASE_URL=
AUTH_DATABASE_URL=

# The API consumes APP_ENV and the PostgreSQL fields above.
APP_ENV=development
# JSON list; production requires explicitly configured HTTPS origins.
ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173","http://127.0.0.1:8000","http://localhost:8000"]
# Restricted worker URL, configured by make db-access.
WORKER_DATABASE_URL=
# Implemented polling interval; bounded to 1-60 seconds.
WORKER_INTERVAL_SECONDS=5
# Domain policy constants: 5 km maximum matching radius, 15-minute pickup grace,
# 0.4 kg estimated meal equivalent. These are documented policy, not env overrides.
# External SMS/push and an emissions factor are not configured.
