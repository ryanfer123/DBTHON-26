# Local-only settings. Copy to .env; fill the empty value locally.
POSTGRES_DB=dbthon
POSTGRES_USER=dbthon
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Planned application settings; no app consumes them yet.
APP_ENV=development
DEFAULT_RADIUS_M=5000
MAX_RADIUS_M=25000
EXPIRY_SWEEP_SECONDS=60
PICKUP_GRACE_MINUTES=15
MEAL_WEIGHT_KG=0.4
# Leave unset until the factor and its source are supported.
CO2E_KG_PER_KG=
CO2E_FACTOR_SOURCE=
NOTIFICATION_CHANNEL=inapp
