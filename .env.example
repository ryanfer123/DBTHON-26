# Local-only settings. Copy to .env; fill the empty value locally.
POSTGRES_DB=dbthon
POSTGRES_USER=dbthon
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
# Separate restricted pools. `make db-access` fills these locally after migration.
APP_DATABASE_URL=
AUTH_DATABASE_URL=

# The API consumes APP_ENV and the PostgreSQL fields above.
APP_ENV=development
# JSON list; production requires explicitly configured HTTPS origins.
ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173","http://127.0.0.1:8000","http://localhost:8000"]
# Planned domain settings for later milestones.
DEFAULT_RADIUS_M=5000
MAX_RADIUS_M=25000
EXPIRY_SWEEP_SECONDS=60
PICKUP_GRACE_MINUTES=15
MEAL_WEIGHT_KG=0.4
# Leave unset until the factor and its source are supported.
CO2E_KG_PER_KG=
CO2E_FACTOR_SOURCE=
NOTIFICATION_CHANNEL=inapp
