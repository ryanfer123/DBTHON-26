{
  "components": {
    "schemas": {
      "CommunityInfo": {
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "roles": {
            "items": {
              "$ref": "#/components/schemas/RoleIntroduction"
            },
            "title": "Roles",
            "type": "array"
          }
        },
        "required": [
          "name",
          "roles"
        ],
        "title": "CommunityInfo",
        "type": "object"
      },
      "CommunityResponse": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/CommunityInfo"
          }
        },
        "required": [
          "data"
        ],
        "title": "CommunityResponse",
        "type": "object"
      },
      "HealthData": {
        "properties": {
          "status": {
            "enum": [
              "alive",
              "ready"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthData",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/HealthData"
          }
        },
        "required": [
          "data"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "RoleIntroduction": {
        "properties": {
          "description": {
            "title": "Description",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "description"
        ],
        "title": "RoleIntroduction",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Zone-based surplus food redistribution. Initial public foundation.",
    "title": "Second Table API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/community": {
      "get": {
        "description": "Public introduction, not a listing feed or a simulated transaction.",
        "operationId": "community_api_v1_community_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommunityResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Community",
        "tags": [
          "Community"
        ]
      }
    },
    "/api/v1/health/live": {
      "get": {
        "operationId": "live_api_v1_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Live",
        "tags": [
          "Health"
        ]
      }
    },
    "/api/v1/health/ready": {
      "get": {
        "operationId": "ready_api_v1_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "description": "PostgreSQL/PostGIS unavailable"
          }
        },
        "summary": "Ready",
        "tags": [
          "Health"
        ]
      }
    }
  }
}
